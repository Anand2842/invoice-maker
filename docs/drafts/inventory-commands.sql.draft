-- Canonical stock is additive. Legacy items.quantity is retained and never read as stock.
create table public.billing_inventory_configs(
 business_id uuid not null,demo boolean not null,start_date date not null,currency text not null,cost_policy text not null check(cost_policy='FIFO'),
 stock_account uuid not null,clearing_account uuid not null,cogs_account uuid not null,adjustment_account uuid not null,opening_account uuid not null,
 actor_id uuid not null references auth.users(id),primary key(business_id,demo),foreign key(business_id,demo) references public.billing_ledger_configs(business_id,demo),
 foreign key(stock_account,business_id,demo) references public.billing_ledger_accounts(id,business_id,demo),foreign key(clearing_account,business_id,demo) references public.billing_ledger_accounts(id,business_id,demo),foreign key(cogs_account,business_id,demo) references public.billing_ledger_accounts(id,business_id,demo),foreign key(adjustment_account,business_id,demo) references public.billing_ledger_accounts(id,business_id,demo),foreign key(opening_account,business_id,demo) references public.billing_ledger_accounts(id,business_id,demo)
);
create table public.billing_inventory_warehouses(id uuid primary key,business_id uuid not null,demo boolean not null,code text not null,name text not null,actor_id uuid not null references auth.users(id),unique(id,business_id,demo),unique(business_id,demo,code),foreign key(business_id,demo) references public.billing_inventory_configs(business_id,demo));
create table public.billing_inventory_items(id uuid primary key,business_id uuid not null,demo boolean not null,legacy_id uuid,sku text not null,name text not null,kind text not null check(kind in ('stock','service')),tracking text not null check(tracking in ('none','batch','serial')),base_unit text not null,barcode text not null default '',reorder_level numeric(24,6) not null default 0,overstock_level numeric(24,6),snapshot jsonb not null,actor_id uuid not null references auth.users(id),unique(id,business_id,demo),unique(business_id,demo,sku),unique(business_id,demo,legacy_id),foreign key(legacy_id,business_id,demo) references public.billing_records(id,business_id,demo),foreign key(business_id,demo) references public.billing_inventory_configs(business_id,demo),check(kind='stock' or tracking='none'));
create table public.billing_inventory_units(id uuid primary key,business_id uuid not null,demo boolean not null,item_id uuid not null,code text not null,factor numeric(24,6) not null check(factor>0 and factor<=10000000000),unique(id,business_id,demo),unique(item_id,code),foreign key(item_id,business_id,demo) references public.billing_inventory_items(id,business_id,demo));
create table public.billing_inventory_lots(id uuid primary key,business_id uuid not null,demo boolean not null,item_id uuid not null,code text not null,expires_on date,warranty_until date,tracking text not null,unique(id,business_id,demo),unique(item_id,code),foreign key(item_id,business_id,demo) references public.billing_inventory_items(id,business_id,demo));
create table public.billing_inventory_source_lines(id uuid primary key,business_id uuid not null,demo boolean not null,source_kind text not null check(source_kind in ('vendor-bill','issued-document')),source_id uuid not null,line integer not null check(line>=0),item_id uuid not null,unit_id uuid not null,direction text not null check(direction in ('incoming','outgoing')),quantity numeric(24,6) not null check(quantity>0),value numeric(18,2),date date not null,snapshot jsonb not null,actor_id uuid not null references auth.users(id),unique(id,business_id,demo),unique(business_id,demo,source_kind,source_id,line),foreign key(item_id,business_id,demo) references public.billing_inventory_items(id,business_id,demo),foreign key(unit_id,business_id,demo) references public.billing_inventory_units(id,business_id,demo));
create table public.billing_inventory_events(id uuid primary key,sequence bigint generated always as identity,business_id uuid not null,demo boolean not null,kind text not null check(kind in ('opening','receipt','dispatch','transfer','customer-return','supplier-return','adjust-in','adjust-out')),date date not null,reason text not null,batch_id uuid unique,actor_id uuid not null references auth.users(id),snapshot jsonb not null,created_at timestamptz not null default now(),unique(id,business_id,demo),foreign key(business_id,demo) references public.billing_inventory_configs(business_id,demo),foreign key(batch_id,business_id,demo) references public.billing_ledger_batches(id,business_id,demo));
create table public.billing_inventory_movements(id uuid primary key,event_id uuid not null,business_id uuid not null,demo boolean not null,item_id uuid not null,warehouse_id uuid not null,lot_id uuid not null,source_line uuid,date date not null,quantity numeric(24,6) not null check(quantity<>0),value numeric(18,2) not null,unique(id,business_id,demo),foreign key(event_id,business_id,demo) references public.billing_inventory_events(id,business_id,demo),foreign key(item_id,business_id,demo) references public.billing_inventory_items(id,business_id,demo),foreign key(warehouse_id,business_id,demo) references public.billing_inventory_warehouses(id,business_id,demo),foreign key(lot_id,business_id,demo) references public.billing_inventory_lots(id,business_id,demo),foreign key(source_line,business_id,demo) references public.billing_inventory_source_lines(id,business_id,demo),check((quantity>0 and value>=0) or(quantity<0 and value<=0)));
create table public.billing_inventory_layers(id uuid primary key,sequence bigint generated always as identity,business_id uuid not null,demo boolean not null,movement_id uuid not null unique,item_id uuid not null,warehouse_id uuid not null,lot_id uuid not null,source_line uuid,root_layer uuid not null,fifo_date date not null,date date not null,quantity numeric(24,6) not null check(quantity>0),value numeric(18,2) not null check(value>=0),return_of uuid,foreign key(movement_id,business_id,demo) references public.billing_inventory_movements(id,business_id,demo),foreign key(root_layer) references public.billing_inventory_layers(id));
create table public.billing_inventory_consumptions(id uuid primary key,layer_id uuid not null references public.billing_inventory_layers(id),movement_id uuid not null references public.billing_inventory_movements(id),event_id uuid not null references public.billing_inventory_events(id),business_id uuid not null,demo boolean not null,date date not null,quantity numeric(24,6) not null check(quantity>0),value numeric(18,2) not null check(value>=0),foreign key(event_id,business_id,demo) references public.billing_inventory_events(id,business_id,demo));
alter table public.billing_inventory_layers add constraint inventory_layer_return foreign key(return_of) references public.billing_inventory_consumptions(id);
create table public.billing_inventory_reservations(id uuid primary key,business_id uuid not null,demo boolean not null,item_id uuid not null,warehouse_id uuid not null,lot_id uuid,source_line uuid,kind text not null check(kind in ('reserve','release','consume')),reservation_id uuid,event_id uuid,date date not null,quantity numeric(24,6) not null check(quantity>0),reason text not null,actor_id uuid not null references auth.users(id),created_at timestamptz not null default now(),unique(id,business_id,demo),check((kind='reserve')=(reservation_id is null)),foreign key(item_id,business_id,demo) references public.billing_inventory_items(id,business_id,demo),foreign key(warehouse_id,business_id,demo) references public.billing_inventory_warehouses(id,business_id,demo),foreign key(lot_id,business_id,demo) references public.billing_inventory_lots(id,business_id,demo),foreign key(source_line,business_id,demo) references public.billing_inventory_source_lines(id,business_id,demo),foreign key(reservation_id,business_id,demo) references public.billing_inventory_reservations(id,business_id,demo),foreign key(event_id,business_id,demo) references public.billing_inventory_events(id,business_id,demo));
create table public.billing_inventory_commands(business_id uuid not null,demo boolean not null,command_id uuid not null,actor_id uuid not null references auth.users(id),request jsonb not null,result jsonb not null,primary key(business_id,demo,command_id),foreign key(business_id,demo) references public.billing_inventory_configs(business_id,demo));
create table public.billing_inventory_outbox(id uuid primary key default gen_random_uuid(),business_id uuid not null,demo boolean not null,command_id uuid not null,topic text not null,payload jsonb not null,created_at timestamptz not null default now(),unique(business_id,demo,command_id),foreign key(business_id,demo,command_id) references public.billing_inventory_commands(business_id,demo,command_id));
create index inventory_movement_scope on public.billing_inventory_movements(business_id,demo,item_id,warehouse_id,date,id);
create index inventory_layer_fifo on public.billing_inventory_layers(business_id,demo,item_id,warehouse_id,fifo_date,sequence);
create index inventory_consumption_layer on public.billing_inventory_consumptions(layer_id,date,id);
create index inventory_reservation_scope on public.billing_inventory_reservations(business_id,demo,item_id,warehouse_id,date,id);
DO $$declare t text;begin foreach t in array array['configs','warehouses','items','units','lots','source_lines','events','movements','layers','consumptions','reservations','commands','outbox'] loop execute format('alter table public.billing_inventory_%I enable row level security',t);execute format('revoke all on public.billing_inventory_%I from public,anon,authenticated',t);execute format('create trigger inventory_%I_immutable before update or delete on public.billing_inventory_%I for each row execute function public.billing_ledger_immutable()',t,t);if t not in ('commands','outbox') then execute format('grant select on public.billing_inventory_%I to authenticated',t);execute format('create policy inventory_%I_read on public.billing_inventory_%I for select to authenticated using(public.billing_can_access(business_id))',t,t);end if;end loop;end$$;
create function public.billing_inventory_quantity(value jsonb) returns numeric language plpgsql immutable set search_path='' as $$declare raw text;n numeric;begin if value is null or jsonb_typeof(value) not in ('string','number') then raise exception 'Enter an exact stock quantity with at most six decimal places';end if;raw=value#>>'{}';if length(raw)>64 or raw!~'^[0-9]+(\.[0-9]{1,6})?$' then raise exception 'Enter an exact stock quantity with at most six decimal places';end if;n=raw::numeric;if n<0 or n>10000000000 then raise exception 'Stock quantity exceeds supported range';end if;return n;end$$;
create function public.billing_inventory_validate(item uuid,warehouse uuid) returns void language plpgsql security definer set search_path='' as $$
begin
 if exists(with movement as(select date,quantity delta from public.billing_inventory_movements where item_id=item and warehouse_id=warehouse union all select date,quantity*case when kind='reserve' then -1 else 1 end from public.billing_inventory_reservations where item_id=item and warehouse_id=warehouse),running as(select sum(sum(delta)) over(order by date) balance from movement group by date) select 1 from running where balance<0) then raise exception 'Stock or reservations would be negative at an effective date';end if;
 if exists(with movement as(select lot_id,date,quantity delta from public.billing_inventory_movements where item_id=item and warehouse_id=warehouse union all select lot_id,date,quantity*case when kind='reserve' then -1 else 1 end from public.billing_inventory_reservations where item_id=item and warehouse_id=warehouse and lot_id is not null),running as(select lot_id,sum(sum(delta)) over(partition by lot_id order by date) balance from movement group by lot_id,date) select 1 from running where balance<0) then raise exception 'Batch/serial stock or reservation would be negative at an effective date';end if;
end$$;
create function public.billing_inventory_validate_source(source uuid) returns void language plpgsql security definer set search_path='' as $$
declare s public.billing_inventory_source_lines;
begin
 if source is null then return;end if;select * into s from public.billing_inventory_source_lines where id=source;
 if exists(with movements as(select date,quantity*case when s.direction='incoming' then 1 else -1 end qty,value*case when s.direction='incoming' then 1 else -1 end cost from public.billing_inventory_movements where source_line=source),running as(select date,sum(sum(qty)) over(order by date) qty,sum(sum(cost)) over(order by date) cost from movements group by date)select 1 from running where qty<0 or qty>s.quantity or s.direction='incoming' and s.value is not null and(cost<0 or cost>s.value)) then raise exception 'Fulfillment exceeds source-line quantity or reviewed purchase value at an effective date';end if;
 if s.direction='outgoing' and exists(with movements as(select date,-quantity qty from public.billing_inventory_movements where source_line=source union all select date,quantity*case when kind='reserve' then 1 else -1 end from public.billing_inventory_reservations where source_line=source),running as(select sum(sum(qty)) over(order by date) qty from movements group by date)select 1 from running where qty>s.quantity or qty<0) then raise exception 'Reserved and fulfilled quantities exceed the source line';end if;
end$$;
create function public.billing_inventory_setup(business uuid,data_mode boolean,start_date date,accounts jsonb,cost_policy text,reviewed boolean) returns jsonb language plpgsql security definer set search_path='' as $$
declare config public.billing_inventory_configs;ledger public.billing_ledger_configs;role text;account uuid;expected_type text;expected_code text;
begin
 if auth.uid() is null or not public.billing_is_owner(business) then raise exception using errcode='42501',message='Only the owner can review canonical inventory cutover and FIFO policy';end if;perform public.billing_ledger_writer_lock(business,true);select * into ledger from public.billing_ledger_configs where business_id=business and demo=data_mode for update;
 if ledger.business_id is null or reviewed is distinct from true or cost_policy is distinct from 'FIFO' or start_date is null or not isfinite(start_date) or jsonb_typeof(accounts) is distinct from 'object' or accounts-array['stock','clearing','cogs','adjustment','opening']<>'{}'::jsonb then raise exception 'Review FIFO, base currency, cutover and five stock posting accounts';end if;
 foreach role in array array['stock','clearing','cogs','adjustment','opening'] loop if coalesce(accounts->>role,'')!~'^[0-9a-fA-F-]{36}$' then raise exception 'Choose all inventory accounts';end if;expected_type=case when role in ('stock','clearing') then 'asset' when role='opening' then 'equity' else 'expense' end;expected_code=case role when 'stock' then '1200' when 'clearing' then '1500' when 'cogs' then '5100' when 'opening' then '3000' else null end;select id into account from public.billing_ledger_accounts a where a.id=(accounts->>role)::uuid and a.business_id=business and a.demo=data_mode and a.type=expected_type and(expected_code is null or a.code=expected_code);if account is null then raise exception 'Review stock1200, purchase-clearing1500, COGS5100, adjustment expense and opening equity3000 classifications';end if;end loop;
 if (accounts->>'stock')::uuid=(accounts->>'clearing')::uuid then raise exception 'Stock and purchase clearing must be separate';end if;
 select * into config from public.billing_inventory_configs where business_id=business and demo=data_mode;if config.business_id is not null then if config.start_date<>start_date or config.stock_account<>(accounts->>'stock')::uuid or config.clearing_account<>(accounts->>'clearing')::uuid or config.cogs_account<>(accounts->>'cogs')::uuid or config.adjustment_account<>(accounts->>'adjustment')::uuid or config.opening_account<>(accounts->>'opening')::uuid then raise exception 'Inventory cutover, FIFO and accounts are immutable';end if;return to_jsonb(config);end if;
 if start_date<ledger.start_date or start_date<=coalesce(ledger.closed_through,start_date-1) or start_date>(select(now() at time zone time_zone)::date from public.billing_businesses where id=business) then raise exception 'Choose an inventory cutover in the open ledger period on or before today';end if;
 insert into public.billing_inventory_configs(business_id,demo,start_date,currency,cost_policy,stock_account,clearing_account,cogs_account,adjustment_account,opening_account,actor_id) values(business,data_mode,start_date,ledger.currency,'FIFO',(accounts->>'stock')::uuid,(accounts->>'clearing')::uuid,(accounts->>'cogs')::uuid,(accounts->>'adjustment')::uuid,(accounts->>'opening')::uuid,auth.uid()) returning * into config;
 insert into public.billing_ledger_audit(business_id,demo,actor_id,action,details) values(business,data_mode,auth.uid(),'inventory.configured',jsonb_build_object('startDate',start_date,'costPolicy','FIFO','legacyQuantitiesImported',false));return to_jsonb(config);
end$$;
create function public.billing_inventory_take(business uuid,data_mode boolean,event uuid,day date,kind text,item uuid,warehouse uuid,quantity numeric,lot uuid,source uuid,target_warehouse uuid,root uuid default null) returns numeric language plpgsql security definer set search_path='' as $$
declare layer record;remaining numeric(24,6)=quantity;take numeric(24,6);cost numeric(18,2);total numeric(18,2)=0;movement uuid;incoming uuid;new_layer uuid;
begin
 for layer in select l.*,l.quantity-coalesce((select sum(c.quantity) from public.billing_inventory_consumptions c where c.layer_id=l.id),0) remaining_quantity,l.value-coalesce((select sum(c.value) from public.billing_inventory_consumptions c where c.layer_id=l.id),0) remaining_value from public.billing_inventory_layers l join public.billing_inventory_lots b on b.id=l.lot_id where l.business_id=business and l.demo=data_mode and l.item_id=item and l.warehouse_id=warehouse and l.date<=day and(lot is null or l.lot_id=lot) and(root is null or l.root_layer=root) and(kind<>'dispatch' or b.expires_on is null or b.expires_on>=day) order by l.fifo_date,l.sequence loop
  if remaining=0 then exit;end if;if layer.remaining_quantity<=0 then continue;end if;take=least(remaining,layer.remaining_quantity);cost=case when take=layer.remaining_quantity then layer.remaining_value else round(layer.remaining_value*take/layer.remaining_quantity,2) end;movement=gen_random_uuid();
  insert into public.billing_inventory_movements(id,event_id,business_id,demo,item_id,warehouse_id,lot_id,source_line,date,quantity,value) values(movement,event,business,data_mode,item,warehouse,layer.lot_id,source,day,-take,-cost);
  insert into public.billing_inventory_consumptions(id,layer_id,movement_id,event_id,business_id,demo,date,quantity,value) values(gen_random_uuid(),layer.id,movement,event,business,data_mode,day,take,cost);
  if kind='transfer' then incoming=gen_random_uuid();new_layer=gen_random_uuid();insert into public.billing_inventory_movements(id,event_id,business_id,demo,item_id,warehouse_id,lot_id,source_line,date,quantity,value) values(incoming,event,business,data_mode,item,target_warehouse,layer.lot_id,source,day,take,cost);insert into public.billing_inventory_layers(id,business_id,demo,movement_id,item_id,warehouse_id,lot_id,source_line,root_layer,fifo_date,date,quantity,value) values(new_layer,business,data_mode,incoming,item,target_warehouse,layer.lot_id,layer.source_line,layer.root_layer,layer.fifo_date,day,take,cost);end if;
  total=total+cost;remaining=remaining-take;
 end loop;
 if remaining>0 then raise exception 'Not enough eligible FIFO stock in this warehouse/lot (expired stock cannot be dispatched)';end if;return total;
end$$;
create function public.billing_inventory_command(business uuid,data_mode boolean,command_id uuid,action text,command_data jsonb) returns jsonb language plpgsql security definer set search_path='' as $$
declare config public.billing_inventory_configs;ledger public.billing_ledger_configs;prior public.billing_inventory_commands;item public.billing_inventory_items;unit public.billing_inventory_units;lot public.billing_inventory_lots;source public.billing_inventory_source_lines;reservation public.billing_inventory_reservations;original public.billing_inventory_consumptions;old_layer public.billing_inventory_layers;old_move public.billing_inventory_movements;bill public.billing_vendor_bills;document public.billing_issued_documents;legacy public.billing_records;
 request jsonb;result jsonb;journal jsonb;line jsonb;snapshot jsonb;event_id uuid;movement uuid;new_layer uuid;id uuid;item_id uuid;warehouse uuid;target uuid;lot_id uuid;source_id uuid;reservation_id uuid;day date;expiry date;warranty date;kind text;reason text;code text;direction text;qty numeric(24,6);factor numeric(24,6);cost numeric(18,2);total numeric(18,2)=0;returned_qty numeric;returned_cost numeric;source_qty numeric;source_cost numeric;counter uuid;debit uuid;credit uuid;n integer;
begin
 if auth.uid() is null or not public.billing_can_access(business,true) then raise exception using errcode='42501',message='Your role cannot change canonical stock';end if;
 if data_mode is null or command_id is null or action is null or action not in ('warehouse','item','unit','link','reserve','release','move') or jsonb_typeof(command_data) is distinct from 'object' then raise exception 'Invalid inventory command';end if;request=jsonb_build_object('action',action,'data',command_data);
 select * into prior from public.billing_inventory_commands c where c.business_id=business and c.demo=data_mode and c.command_id=billing_inventory_command.command_id;if prior.command_id is not null then if prior.actor_id<>auth.uid() or prior.request<>request then raise exception using errcode='40001',message='Retry key was used for different inventory details';end if;return prior.result||jsonb_build_object('replayed',true);end if;
 perform public.billing_ledger_writer_lock(business,false);select * into ledger from public.billing_ledger_configs where business_id=business and demo=data_mode for update;select * into config from public.billing_inventory_configs where business_id=business and demo=data_mode;if config.business_id is null then raise exception 'Review canonical inventory cutover/FIFO/accounts first; legacy scalar quantities are not imported';end if;
 select * into prior from public.billing_inventory_commands c where c.business_id=business and c.demo=data_mode and c.command_id=billing_inventory_command.command_id;if prior.command_id is not null then if prior.actor_id<>auth.uid() or prior.request<>request then raise exception using errcode='40001',message='Retry key was used for different inventory details';end if;return prior.result||jsonb_build_object('replayed',true);end if;
 if action='warehouse' then
  if command_data-array['code','name']<>'{}'::jsonb or coalesce(command_data->>'code','')!~'^[A-Za-z0-9._-]{1,40}$' or jsonb_typeof(command_data->'name') is distinct from 'string' or length(btrim(command_data->>'name')) not between 1 and 180 then raise exception 'Enter warehouse code and name';end if;id=gen_random_uuid();insert into public.billing_inventory_warehouses(id,business_id,demo,code,name,actor_id) values(id,business,data_mode,command_data->>'code',btrim(command_data->>'name'),auth.uid());result=jsonb_build_object('warehouseId',id,'replayed',false);
 elsif action='item' then
  if command_data-array['legacyId','sku','name','kind','tracking','baseUnit','barcode','reorderLevel','overstockLevel','reviewed']<>'{}'::jsonb or command_data->'reviewed' is distinct from 'true'::jsonb or coalesce(command_data->>'sku','')!~'^[A-Za-z0-9._/-]{1,80}$' or jsonb_typeof(command_data->'name') is distinct from 'string' or length(btrim(command_data->>'name')) not between 1 and 500 or coalesce(command_data->>'baseUnit','')!~'^[A-Za-z0-9._-]{1,30}$' or coalesce(command_data->>'kind','') not in ('stock','service') or coalesce(command_data->>'tracking','') not in ('none','batch','serial') or jsonb_typeof(command_data->'barcode') is distinct from 'string' or length(command_data->>'barcode')>180 then raise exception 'Review canonical item identity, stock/service type, tracking and base UOM';end if;
  if command_data->>'kind'='service' and command_data->>'tracking'<>'none' then raise exception 'Services do not have stock batches/serials';end if;id=gen_random_uuid();source_id=null;if command_data->>'legacyId' is not null then if coalesce(command_data->>'legacyId','')!~'^[0-9a-fA-F-]{36}$' then raise exception 'Choose exact legacy item ID or omit it';end if;select * into legacy from public.billing_records r where r.id=(command_data->>'legacyId')::uuid and r.business_id=business and r.demo=data_mode and r.collection='items';if legacy.id is null then raise exception 'Legacy item unavailable in this scope';end if;source_id=legacy.id;end if;
  qty=public.billing_inventory_quantity(coalesce(command_data->'reorderLevel','"0"'::jsonb));source_qty=null;if command_data->>'overstockLevel' is not null then source_qty=public.billing_inventory_quantity(command_data->'overstockLevel');if source_qty<qty then raise exception 'Overstock level cannot be below reorder level';end if;end if;
  insert into public.billing_inventory_items(id,business_id,demo,legacy_id,sku,name,kind,tracking,base_unit,barcode,reorder_level,overstock_level,snapshot,actor_id) values(id,business,data_mode,source_id,command_data->>'sku',btrim(command_data->>'name'),command_data->>'kind',command_data->>'tracking',command_data->>'baseUnit',command_data->>'barcode',qty,source_qty,jsonb_build_object('legacy',case when legacy.id is null then null else legacy.data end,'legacyQuantityImported',false,'review',command_data),auth.uid());new_layer=gen_random_uuid();insert into public.billing_inventory_units(id,business_id,demo,item_id,code,factor) values(new_layer,business,data_mode,id,command_data->>'baseUnit',1);result=jsonb_build_object('itemId',id,'baseUnitId',new_layer,'legacyQuantityImported',false,'replayed',false);
 elsif action='unit' then
  if command_data-array['itemId','code','factor']<>'{}'::jsonb or coalesce(command_data->>'itemId','')!~'^[0-9a-fA-F-]{36}$' or coalesce(command_data->>'code','')!~'^[A-Za-z0-9._-]{1,30}$' then raise exception 'Choose canonical item and unit code';end if;select * into item from public.billing_inventory_items i where i.id=(command_data->>'itemId')::uuid and i.business_id=business and i.demo=data_mode;if item.id is null then raise exception 'Canonical item unavailable in this scope';end if;factor=public.billing_inventory_quantity(command_data->'factor');if factor<=0 then raise exception 'Unit conversion factor must be positive';end if;id=gen_random_uuid();insert into public.billing_inventory_units(id,business_id,demo,item_id,code,factor) values(id,business,data_mode,item.id,command_data->>'code',factor);result=jsonb_build_object('unitId',id,'replayed',false);
 elsif action='link' then
  if command_data-array['sourceKind','sourceId','line','itemId','unitId','reviewed']<>'{}'::jsonb or command_data->'reviewed' is distinct from 'true'::jsonb or coalesce(command_data->>'sourceId','')!~'^[0-9a-fA-F-]{36}$' or coalesce(command_data->>'itemId','')!~'^[0-9a-fA-F-]{36}$' or coalesce(command_data->>'unitId','')!~'^[0-9a-fA-F-]{36}$' or coalesce(command_data->>'line','')!~'^[0-9]{1,3}$' then raise exception 'Review exact source line, item identity and source UOM mapping';end if;n=(command_data->>'line')::integer;select * into unit from public.billing_inventory_units u where u.id=(command_data->>'unitId')::uuid and u.item_id=(command_data->>'itemId')::uuid and u.business_id=business and u.demo=data_mode;select * into item from public.billing_inventory_items where id=unit.item_id;if unit.id is null or item.kind<>'stock' then raise exception 'Source fulfillment requires a canonical stock item/UOM';end if;cost=null;
  if command_data->>'sourceKind'='vendor-bill' then select * into bill from public.billing_vendor_bills b where b.id=(command_data->>'sourceId')::uuid and b.business_id=business and b.demo=data_mode and b.status='issued';if bill.id is null or exists(select 1 from public.billing_ledger_batches where reverses_id=bill.issued_batch) or bill.data->>'accountId'<>config.clearing_account::text then raise exception 'Linked receipts require an active issued bill posted to purchase clearing1500, never directly to inventory1200';end if;line=bill.data->'items'->n;day=(bill.data->>'date')::date;direction='incoming';snapshot=bill.data;cost=public.billing_ledger_amount(line->'amount');
  elsif command_data->>'sourceKind'='issued-document' then select * into document from public.billing_issued_documents d where d.document_id=(command_data->>'sourceId')::uuid and d.business_id=business and d.demo=data_mode;if document.document_id is null or exists(select 1 from public.billing_document_cancellations where document_id=document.document_id) or document.type not in ('invoice','gst-invoice','commercial-invoice','delivery-challan','purchase-order') then raise exception 'Choose a frozen issued invoice/challan/purchase-order source';end if;line=document.snapshot->'items'->n;day=document.date;direction=case when document.type='purchase-order' then 'incoming' else 'outgoing' end;snapshot=document.snapshot;
  else raise exception 'Choose issued-document or vendor-bill source';end if;
  qty=public.billing_inventory_quantity(line->'quantity')*unit.factor;if qty<=0 or qty<>round(qty,6) or qty>10000000000 then raise exception 'Source quantity/UOM exceeds supported base precision';end if;id=gen_random_uuid();insert into public.billing_inventory_source_lines(id,business_id,demo,source_kind,source_id,line,item_id,unit_id,direction,quantity,value,date,snapshot,actor_id) values(id,business,data_mode,command_data->>'sourceKind',(command_data->>'sourceId')::uuid,n,item.id,unit.id,direction,qty,cost,day,jsonb_build_object('document',snapshot,'line',line,'item',to_jsonb(item),'unit',to_jsonb(unit),'mappingReviewed',true),auth.uid());result=jsonb_build_object('sourceLineId',id,'quantity',qty::text,'direction',direction,'replayed',false);
 else
  day=public.billing_payment_date(command_data->'date');reason=btrim(command_data->>'reason');if day<config.start_date or day<=coalesce(ledger.closed_through,day-1) or day>(select(now() at time zone time_zone)::date from public.billing_businesses where id=business) or jsonb_typeof(command_data->'reason') is distinct from 'string' or length(reason) not between 1 and 1000 then raise exception 'Choose an open inventory effective date and reason';end if;
  if action in ('reserve','release') then
   if action='reserve' then
    if command_data-array['date','reason','itemId','unitId','warehouseId','lotId','sourceLineId','quantity']<>'{}'::jsonb then raise exception 'Unexpected reservation fields';end if;
    select * into unit from public.billing_inventory_units u where u.id=(command_data->>'unitId')::uuid and u.item_id=(command_data->>'itemId')::uuid and u.business_id=business and u.demo=data_mode;select * into item from public.billing_inventory_items where id=unit.item_id;warehouse=(command_data->>'warehouseId')::uuid;lot_id=nullif(command_data->>'lotId','')::uuid;source_id=nullif(command_data->>'sourceLineId','')::uuid;qty=public.billing_inventory_quantity(command_data->'quantity')*unit.factor;
    if unit.id is null or item.kind<>'stock' or qty<=0 or qty<>round(qty,6) or qty>10000000000 or not exists(select 1 from public.billing_inventory_warehouses where id=warehouse and business_id=business and demo=data_mode) then raise exception 'Choose stock item, exact unit quantity and warehouse';end if;
    if item.tracking<>'none' and lot_id is null then raise exception 'Tracked reservations require an exact batch/serial';end if;if lot_id is not null and not exists(select 1 from public.billing_inventory_lots where id=lot_id and item_id=item.id and(expires_on is null or expires_on>=day)) then raise exception 'Choose an unexpired batch/serial for this item';end if;
    if source_id is not null then select * into source from public.billing_inventory_source_lines where id=source_id and business_id=business and demo=data_mode;if source.id is null or source.item_id<>item.id or source.direction<>'outgoing' or day<source.date then raise exception 'Choose an outgoing source line for this stock item/date';end if;end if;id=gen_random_uuid();insert into public.billing_inventory_reservations(id,business_id,demo,item_id,warehouse_id,lot_id,source_line,kind,date,quantity,reason,actor_id) values(id,business,data_mode,item.id,warehouse,lot_id,source_id,'reserve',day,qty,reason,auth.uid());
   else
    if command_data-array['date','reason','reservationId','quantity']<>'{}'::jsonb then raise exception 'Unexpected reservation release fields';end if;select * into reservation from public.billing_inventory_reservations r where r.id=(command_data->>'reservationId')::uuid and r.business_id=business and r.demo=data_mode and r.kind='reserve';qty=public.billing_inventory_quantity(command_data->'quantity');if reservation.id is null or qty<=0 or day<reservation.date or qty>reservation.quantity-coalesce((select sum(quantity) from public.billing_inventory_reservations where reservation_id=reservation.id),0) then raise exception 'Release exceeds remaining reservation or predates it';end if;id=gen_random_uuid();item_id=reservation.item_id;warehouse=reservation.warehouse_id;source_id=reservation.source_line;insert into public.billing_inventory_reservations(id,business_id,demo,item_id,warehouse_id,lot_id,source_line,kind,reservation_id,date,quantity,reason,actor_id) values(id,business,data_mode,item_id,warehouse,reservation.lot_id,source_id,'release',reservation.id,day,qty,reason,auth.uid());select * into item from public.billing_inventory_items where public.billing_inventory_items.id=item_id;
   end if;perform public.billing_inventory_validate(item.id,warehouse);perform public.billing_inventory_validate_source(source_id);result=jsonb_build_object('reservationEventId',id,'kind',action,'quantity',qty::text,'replayed',false);
  else
   kind=command_data->>'kind';if command_data-array['date','reason','kind','lines','costReviewed']<>'{}'::jsonb or kind is null or kind not in ('opening','receipt','dispatch','transfer','customer-return','supplier-return','adjust-in','adjust-out') or command_data->'costReviewed' is distinct from 'true'::jsonb or jsonb_typeof(command_data->'lines') is distinct from 'array' or jsonb_array_length(command_data->'lines') not between 1 and 50 then raise exception 'Review stock movement type, 1-50 lines and exact costing';end if;
   if kind='opening' and(not public.billing_is_owner(business) or day<>config.start_date) then raise exception 'Opening quantities/valuation require owner review at the inventory cutover date';end if;event_id=gen_random_uuid();insert into public.billing_inventory_events(id,business_id,demo,kind,date,reason,actor_id,snapshot) values(event_id,business,data_mode,kind,day,reason,auth.uid(),jsonb_build_object('costPolicy','FIFO','currency',config.currency,'request',command_data,'legacyQuantityImported',false));
   for line in select value from jsonb_array_elements(command_data->'lines') loop
    if jsonb_typeof(line) is distinct from 'object' or line-array['itemId','unitId','warehouseId','targetWarehouseId','lotId','lotCode','expiresOn','warrantyUntil','sourceLineId','reservationId','returnOf','quantity','cost']<>'{}'::jsonb then raise exception 'Unexpected stock movement line';end if;
    select * into unit from public.billing_inventory_units u where u.id=(line->>'unitId')::uuid and u.item_id=(line->>'itemId')::uuid and u.business_id=business and u.demo=data_mode;select * into item from public.billing_inventory_items where public.billing_inventory_items.id=unit.item_id;warehouse=(line->>'warehouseId')::uuid;target=nullif(line->>'targetWarehouseId','')::uuid;lot_id=nullif(line->>'lotId','')::uuid;source_id=nullif(line->>'sourceLineId','')::uuid;reservation_id=nullif(line->>'reservationId','')::uuid;qty=public.billing_inventory_quantity(line->'quantity')*unit.factor;
    if unit.id is null or item.kind<>'stock' or qty<=0 or qty<>round(qty,6) or qty>10000000000 or not exists(select 1 from public.billing_inventory_warehouses where public.billing_inventory_warehouses.id=warehouse and business_id=business and demo=data_mode) then raise exception 'Choose canonical stock item/UOM, warehouse and positive exact quantity; services never move stock';end if;
    if item.tracking='serial' and qty<>1 then raise exception 'Each serialized movement line represents exactly one base unit';end if;
    if exists(select 1 from public.billing_inventory_consumptions c join public.billing_inventory_movements m on m.id=c.movement_id where m.item_id=item.id and c.date>day) then raise exception 'Backdated movement changes frozen FIFO consumption; use a reviewed recost/correction workflow';end if;
    if source_id is not null then select * into source from public.billing_inventory_source_lines where public.billing_inventory_source_lines.id=source_id and business_id=business and demo=data_mode;if source.id is null or source.item_id<>item.id or day<source.date or kind='receipt' and source.direction<>'incoming' or kind='dispatch' and source.direction<>'outgoing' then raise exception 'Source-line identity, direction, item or effective date differs';end if;end if;
    if kind='transfer' and(target is null or target=warehouse or not exists(select 1 from public.billing_inventory_warehouses where public.billing_inventory_warehouses.id=target and business_id=business and demo=data_mode)) then raise exception 'Choose distinct source and destination warehouses';end if;
    if kind in ('opening','receipt','adjust-in') then
     if item.tracking='none' then code='UNTRACKED';expiry=null;warranty=null;else code=btrim(line->>'lotCode');if jsonb_typeof(line->'lotCode') is distinct from 'string' or length(code) not between 1 and 180 then raise exception 'Enter batch/serial identity';end if;expiry=case when nullif(line->>'expiresOn','') is null then null else public.billing_payment_date(line->'expiresOn') end;warranty=case when nullif(line->>'warrantyUntil','') is null then null else public.billing_payment_date(line->'warrantyUntil') end;end if;
     select * into lot from public.billing_inventory_lots b where b.item_id=item.id and b.code=code;if lot.id is null then lot_id=gen_random_uuid();insert into public.billing_inventory_lots(id,business_id,demo,item_id,code,expires_on,warranty_until,tracking) values(lot_id,business,data_mode,item.id,code,expiry,warranty,item.tracking);else if item.tracking='serial' then raise exception 'Serial already exists; use its traceable customer-return command';end if;if lot.expires_on is distinct from expiry or lot.warranty_until is distinct from warranty then raise exception 'Existing batch expiry/warranty identity cannot be changed';end if;lot_id=lot.id;end if;
     if kind='opening' and exists(select 1 from public.billing_inventory_movements m where m.item_id=item.id and m.warehouse_id=warehouse and m.lot_id=lot_id) then raise exception 'Opening quantity already reviewed for this item/warehouse/lot';end if;
     if kind='receipt' and source_id is not null and source.value is not null then select coalesce(sum(quantity),0),coalesce(sum(value),0) into source_qty,source_cost from public.billing_inventory_movements where source_line=source.id;cost=case when qty=source.quantity-source_qty then source.value-source_cost else round(source.value*qty/source.quantity,2) end;if line?'cost' and public.billing_ledger_amount(line->'cost')<>cost then raise exception 'Linked bill receipt cost is derived from reviewed source value, including its final cent';end if;else cost=public.billing_ledger_amount(line->'cost');end if;
     movement=gen_random_uuid();new_layer=gen_random_uuid();insert into public.billing_inventory_movements(id,event_id,business_id,demo,item_id,warehouse_id,lot_id,source_line,date,quantity,value) values(movement,event_id,business,data_mode,item.id,warehouse,lot_id,source_id,day,qty,cost);insert into public.billing_inventory_layers(id,business_id,demo,movement_id,item_id,warehouse_id,lot_id,source_line,root_layer,fifo_date,date,quantity,value) values(new_layer,business,data_mode,movement,item.id,warehouse,lot_id,source_id,new_layer,day,day,qty,cost);
    elsif kind='customer-return' then
     select * into original from public.billing_inventory_consumptions c where c.id=(line->>'returnOf')::uuid and c.business_id=business and c.demo=data_mode;select * into old_move from public.billing_inventory_movements where public.billing_inventory_movements.id=original.movement_id;select * into old_layer from public.billing_inventory_layers where public.billing_inventory_layers.id=original.layer_id;
     if original.id is null or old_move.item_id<>item.id or day<original.date or not exists(select 1 from public.billing_inventory_events where id=original.event_id and public.billing_inventory_events.kind='dispatch') then raise exception 'Customer return needs an exact dispatch cost-consumption link';end if;select coalesce(sum(quantity),0),coalesce(sum(value),0) into returned_qty,returned_cost from public.billing_inventory_layers where return_of=original.id;if qty>original.quantity-returned_qty then raise exception 'Customer return exceeds original dispatched quantity';end if;cost=case when qty=original.quantity-returned_qty then original.value-returned_cost else round(original.value*qty/original.quantity,2) end;lot_id=old_layer.lot_id;source_id=old_move.source_line;movement=gen_random_uuid();new_layer=gen_random_uuid();insert into public.billing_inventory_movements(id,event_id,business_id,demo,item_id,warehouse_id,lot_id,source_line,date,quantity,value) values(movement,event_id,business,data_mode,item.id,warehouse,lot_id,source_id,day,qty,cost);insert into public.billing_inventory_layers(id,business_id,demo,movement_id,item_id,warehouse_id,lot_id,source_line,root_layer,fifo_date,date,quantity,value,return_of) values(new_layer,business,data_mode,movement,item.id,warehouse,lot_id,old_layer.source_line,old_layer.root_layer,day,day,qty,cost,original.id);
    else
     if reservation_id is not null then
      if kind<>'dispatch' then raise exception 'Reservations are consumed only by dispatch';end if;select * into reservation from public.billing_inventory_reservations r where r.id=reservation_id and r.business_id=business and r.demo=data_mode and r.kind='reserve';if reservation.id is null or reservation.item_id<>item.id or reservation.warehouse_id<>warehouse or day<reservation.date or qty>reservation.quantity-coalesce((select sum(quantity) from public.billing_inventory_reservations where public.billing_inventory_reservations.reservation_id=reservation.id),0) then raise exception 'Dispatch exceeds or differs from its reservation';end if;if source_id is distinct from reservation.source_line or lot_id is not null and reservation.lot_id is not null and lot_id<>reservation.lot_id then raise exception 'Reservation source/batch differs from dispatch';end if;lot_id=coalesce(lot_id,reservation.lot_id);insert into public.billing_inventory_reservations(id,business_id,demo,item_id,warehouse_id,lot_id,source_line,kind,reservation_id,event_id,date,quantity,reason,actor_id) values(gen_random_uuid(),business,data_mode,item.id,warehouse,lot_id,source_id,'consume',reservation.id,event_id,day,qty,reason,auth.uid());end if;
     new_layer=null;if kind='supplier-return' then select * into old_layer from public.billing_inventory_layers l where l.id=(line->>'returnOf')::uuid and l.business_id=business and l.demo=data_mode and l.item_id=item.id;if old_layer.id is null then raise exception 'Supplier return needs its original receipt/root layer';end if;new_layer=old_layer.root_layer;source_id=old_layer.source_line;end if;
     cost=public.billing_inventory_take(business,data_mode,event_id,day,kind,item.id,warehouse,qty,lot_id,source_id,target,new_layer);
    end if;
    total=total+cost;if total>10000000000 then raise exception 'Bulk movement valuation exceeds supported ledger amount';end if;perform public.billing_inventory_validate(item.id,warehouse);if kind='transfer' then perform public.billing_inventory_validate(item.id,target);end if;perform public.billing_inventory_validate_source(source_id);
    if item.tracking='serial' and exists(with movements as(select lot_id,date,sum(quantity) qty from public.billing_inventory_movements where public.billing_inventory_movements.item_id=item.id group by lot_id,date),running as(select sum(qty) over(partition by lot_id order by date) qty from movements)select 1 from running where qty not between 0 and 1) then raise exception 'Serialized stock must remain zero or one unit across every warehouse/date';end if;
   end loop;
   if kind<>'transfer' and total>0 then counter=case kind when 'opening' then config.opening_account when 'receipt' then config.clearing_account when 'supplier-return' then config.clearing_account when 'dispatch' then config.cogs_account when 'customer-return' then config.cogs_account else config.adjustment_account end;debit=case when kind in ('opening','receipt','customer-return','adjust-in') then config.stock_account else counter end;credit=case when kind in ('opening','receipt','customer-return','adjust-in') then counter else config.stock_account end;journal=(public.billing_ledger_commit(business,data_mode,event_id,request,jsonb_build_object('date',day,'kind','manual','description','Inventory '||kind||': '||left(reason,900),'entries',jsonb_build_array(jsonb_build_object('account_id',debit,'debit',total::text,'credit','0'),jsonb_build_object('account_id',credit,'debit','0','credit',total::text)))))->'batch';end if;
   insert into public.billing_inventory_postings(event_id,business_id,demo,batch_id,financial_effect) values(event_id,business,data_mode,(journal->>'id')::uuid,case when kind='transfer' then 'warehouse-transfer-zero-net' when total=0 then 'reviewed-zero-cost' else 'posted' end);
   result=jsonb_build_object('eventId',event_id,'kind',kind,'date',day,'valuation',total::text,'journal',journal,'movements',(select jsonb_agg(to_jsonb(m)||jsonb_build_object('quantity',m.quantity::text,'value',m.value::text) order by m.id) from public.billing_inventory_movements m where m.event_id=event_id),'consumptions',coalesce((select jsonb_agg(to_jsonb(c)||jsonb_build_object('quantity',c.quantity::text,'value',c.value::text) order by c.id) from public.billing_inventory_consumptions c where c.event_id=event_id),'[]'::jsonb),'layers',coalesce((select jsonb_agg(to_jsonb(l)||jsonb_build_object('quantity',l.quantity::text,'value',l.value::text) order by l.sequence) from public.billing_inventory_layers l join public.billing_inventory_movements m on m.id=l.movement_id where m.event_id=event_id),'[]'::jsonb),'replayed',false);
  end if;
 end if;
 insert into public.billing_inventory_commands(business_id,demo,command_id,actor_id,request,result) values(business,data_mode,command_id,auth.uid(),request,result);insert into public.billing_inventory_audit(business_id,demo,actor_id,action,details) values(business,data_mode,auth.uid(),'inventory.'||action,jsonb_build_object('eventId',event_id,'result',result));insert into public.billing_inventory_outbox(business_id,demo,command_id,topic,payload) values(business,data_mode,command_id,'inventory.'||action,result);return result;
end$$;
